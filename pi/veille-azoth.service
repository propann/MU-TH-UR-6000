# =============================================================
#  Service systemd de la Veille Azoth (Raspberry Pi / Debian)
#  Installe automatiquement par install-pi.sh. A la main :
#    sudo cp veille-azoth.service /etc/systemd/system/
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now veille-azoth
#  Commandes utiles :
#    systemctl status veille-azoth      etat du service
#    journalctl -u veille-azoth -f      journal en direct
#    sudo systemctl restart veille-azoth
# =============================================================
[Unit]
Description=Veille Azoth - tableau de bord de veille technologique
# attendre que le reseau soit vraiment pret (sinon la 1re collecte echoue)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# __USER__ et __DIR__ sont remplaces par install-pi.sh
User=__USER__
WorkingDirectory=__DIR__
# le mot de passe est lu dans ce fichier (droits 600), pas ecrit ici en clair
EnvironmentFile=-/etc/veille-azoth.env
ExecStart=/usr/bin/python3 __DIR__/veille.py --host 0.0.0.0 --port 8765 --no-browser
Restart=on-failure
RestartSec=10
# durcissement : le service ne peut ecrire que dans son dossier
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__DIR__
PrivateTmp=true

[Install]
WantedBy=multi-user.target
